<?xml version="1.0" encoding="UTF-8"?>
<addons>
  <addon id="service.subtitles.multinapisypl" name="MultiNapisyPl" version="1" provider-name="MultiNapisyPl">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.requests" />
      <import addon="script.module.future" />
      <import addon="script.module.beautifulsoup4" />
      <import addon="service.subtitles.a4ksubtitles" version="3.26.1" optional="true" />
    </requires>
    <extension point="xbmc.subtitle.module" library="service.py" />
    <extension point="xbmc.service" library="playback_monitor.py" start="login" />
    <extension point="xbmc.addon.metadata">
      <summary lang="pl_PL">MultiNapisyPl</summary>
      <description lang="pl_PL">Wspólna lista: Napisy24, OpenSubtitles (a4kSubtitles), NapiProjekt Katalog. Wyniki pojawiają się po zakończeniu równoległego wyszukiwania.</description>
      <platform>all</platform>
      <license>GPL-2.0</license>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
  <addon id="repository.multinapisypl" name="MultiNapisyPl Repository" version="1.0.0" provider-name="MultiNapisyPl">
    <extension point="xbmc.addon.repository" name="MultiNapisyPl Repository">
      <info compressed="false">https://leszekgd71.github.io/MultiNapisyPl/addons.xml</info>
      <checksum>https://leszekgd71.github.io/MultiNapisyPl/addons.xml.md5</checksum>
      <datadir zip="true">https://leszekgd71.github.io/MultiNapisyPl/</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pl_PL">Repozytorium dodatku MultiNapisyPl</summary>
      <description lang="pl_PL">Instalacja i aktualizacje dodatku MultiNapisyPl.</description>
      <platform>all</platform>
      <license>GPL-2.0</license>
    </extension>
  </addon>
</addons>